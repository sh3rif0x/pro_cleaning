/* =========================
   TEAM
========================= */

.team {
    width: 100%;
    padding: 140px 0 100px;
    display: flex;
    flex-direction: column;
    gap: 70px;
}

/* Team avatar */

.team .avatar {
    width: 300px;
    height: 300px;
    object-fit: cover;
    border-radius: 18px;
}

/* Stars */

.star-icons-img {
    width: 50px;
    max-width: 50px;
    object-fit: contain;
}

/* =========================
   TEAM HEADER
========================= */

.team header {
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 50px;
    padding-bottom: 25px;
    border-bottom: 1px solid #e5e5e5;
}

.team header .left {
    width: 45%;
    text-align: left;
}

.team header .right {
    width: 40%;
    text-align: left;
}

.team header .right p {
    max-width: 450px;
    line-height: 1.7;
}

/* =========================
   TEAM BANNER
========================= */

.team-banner {
    width: 100%;
    min-height: 500px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 80px;
}

/* =========================
   LEFT IMAGE AREA
========================= */

.team-banner .left {
    width: 50%;
    min-height: 450px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.team-banner .left .images-box {
    width: 380px;
    height: 330px;
    position: relative;
    z-index: 1;

    background-image: url("../assets/Image_2-005.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    border-radius: 20px;
    overflow: visible;

    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.10);
}

/* Green decoration */

.team-banner .left .images-box::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    left: -20px;
    top: 20px;
    border: 2px solid var(--green-color);
    border-radius: 20px;
    z-index: -1;
}

/* Big image */

.team-banner .left .big-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
}

/* Small image */

.team-banner .small-img {
    position: absolute;
    width: 190px;
    height: 190px;
    object-fit: cover;

    bottom: -50px;
    right: -70px;

    z-index: 3;

    border-radius: 18px;
    border: 8px solid white;

    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
}

/* =========================
   RIGHT CONTENT
========================= */

.team-banner .right {
    width: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 25px;
}

.team-banner .right h2,
.team-banner .right h3 {
    color: #14231b;
}

.team-banner p {
    max-width: 450px;
    line-height: 1.8;
    color: var(--gray-color);
}

/* =========================
   FEATURES
========================= */

.features {
    width: 100%;
    display: flex;
    gap: 30px;
    margin-top: 20px;
}

.features > div {
    flex: 1;
    padding: 25px;
    background: #fafafa;
    border: 1px solid #eeeeee;
    border-radius: 14px;
    transition: 
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.features > div:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 900px) {

    .team {
        padding: 100px 30px 80px;
    }

    .team header {
        flex-direction: column;
        align-items: flex-start;
    }

    .team header .left,
    .team header .right {
        width: 100%;
    }

    .team-banner {
        flex-direction: column;
        gap: 80px;
    }

    .team-banner .left,
    .team-banner .right {
        width: 100%;
    }

    .team-banner .left {
        min-height: 400px;
    }

    .team-banner .right {
        align-items: flex-start;
    }
}

@media (max-width: 600px) {

    .team {
        padding: 80px 20px;
    }

    .team-banner .left .images-box {
        width: 280px;
        height: 280px;
    }

    .team-banner .small-img {
        width: 140px;
        height: 140px;
        right: -20px;
        bottom: -40px;
    }

    .features {
        flex-direction: column;
    }

    .team .avatar {
        width: 240px;
        height: 240px;
    }
}